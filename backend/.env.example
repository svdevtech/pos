APP_ENV=dev
HTTP_ADDR=:8090
DATABASE_URL=postgres://pos:pos@localhost:54322/pos?sslmode=disable
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
CORS_ORIGINS=http://localhost:3010
AUTO_MIGRATE=true
LOG_LEVEL=info
# AI (T-LLM gateway) — keep disabled until the gateway is reachable / whitelisted
AI_ENABLED=false
TLLM_BASE_URL=http://192.168.1.116:9001
TLLM_ADMIN_TOKEN=
TLLM_MODEL=T-LLM-GC
# LINE LIFF — mock until real channel credentials exist
LINE_MOCK=true
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LIFF_ID=
# first-run bootstrap (cmd/seed)
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=
