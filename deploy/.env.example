# Copy to /data/pos/.env on the server (kept OUTSIDE the source tree). Generate secrets with: openssl rand -hex 32
APP_ENV=prod
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# published ports on tee-dev (other projects use 3000-3006, 8000-8089, 54321, 63791)
WEB_PORT=3010
API_PORT=8090
PG_PORT=54322
# host directories: pgdata is the database, appdata holds backups + uploaded legacy dumps
PG_DATA=/data/pos/pgdata
DATA_DIR=/data/pos/appdata
LEGACY_DIR=/data/pos/legacy
CORS_ORIGINS=http://localhost:3010,http://192.168.1.120:3010,http://100.122.174.19:3010,https://pos.tdev2022.com
# AI gateway (T-LLM). Two options, same API:
#   https://hybrid-llm-sp01.tdev2022.com  spark01 over HTTPS — reachable from tee-dev today (in use)
#   http://192.168.1.116:9001             Local Spark on the LAN — faster, but that host currently
#                                         drops every port from 192.168.1.120; open 9001 for this
#                                         server (and whitelist its IP in config.security.ip_whitelist)
#                                         before switching back
AI_ENABLED=true
TLLM_BASE_URL=https://hybrid-llm-sp01.tdev2022.com
TLLM_ADMIN_TOKEN=
TLLM_MODEL=T-LLM-GC
# LINE LIFF (mock until real channel exists)
LINE_MOCK=true
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LIFF_ID=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LINE_MOCK=true
# bootstrap
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=change-me
